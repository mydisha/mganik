# Salin ke .env hanya kalau ingin mengubah default. Tanpa .env pun
# `docker compose up --build` sudah jalan dengan nilai di bawah.

APP_ENV=production
LOG_LEVEL=info

# Ganti sebelum stack dibuka ke jaringan lain.
POSTGRES_PASSWORD=mganik

# Kunci HMAC untuk hash PIN klaim hologram. Wajib minimal 32 byte kalau
# APP_ENV=production. Nilai di bawah adalah default demo publik (sama dengan
# compose dan Makefile); buat nilai sendiri untuk deployment sungguhan, misal:
# openssl rand -base64 48
CLAIM_PEPPER=demo-claim-pepper-ganti-sebelum-dipakai-sungguhan

# Kunci induk data pribadi konsumen: subkey enkripsi AES-256-GCM nomor HP,
# blind index, dan hash IP diturunkan darinya (HKDF). Min. 32 byte kalau
# APP_ENV=production. Default demo publik; mengganti kunci ini membuat nomor
# HP konsumen yang sudah tersimpan tidak bisa dibaca/dicari lagi.
PII_ENC_KEY=demo-pii-enc-key-ganti-sebelum-dipakai-sungguhan

# Kode OTP mock untuk login konsumen (belum ada pengirim SMS). Ditolak di
# production kecuali SEED_DEMO_ALLOW_PRODUCTION=true.
OTP_MOCK_CODE=246810

# Origin tambahan (dipisah koma) yang boleh mengirim request ber-cookie.
# Kosong = hanya host yang sama. Compose default ke origin web di WEB_PORT.
# ALLOWED_ORIGINS=http://localhost:8088

# Data demo diisi service migrate (`api migrate --seed`). false = migrasi saja.
SEED_DEMO=true
# Password semua akun demo (min. 12 karakter). Lihat README.
SEED_DEMO_PASSWORD=mganik-demo-2026

# Compose adalah stack demo lokal: izinkan pepper/akun demo walau
# APP_ENV=production (api dan migrate menulis WARN saat start). Set false untuk
# deployment sungguhan; config lalu menolak SEED_DEMO=true, pepper demo, dan
# password demo default.
SEED_DEMO_ALLOW_PRODUCTION=true

# Jaringan proyek compose: subnet tetap, IP statis container web (nginx), dan
# rentang IP dinamis container lain (tidak boleh memuat COMPOSE_WEB_IP). Api
# hanya memercayai X-Forwarded-For dari COMPOSE_WEB_IP (default
# TRUSTED_PROXIES). Ubah ketiganya bersama kalau subnet bentrok di host.
COMPOSE_SUBNET=172.31.250.0/24
COMPOSE_WEB_IP=172.31.250.10
COMPOSE_IP_RANGE=172.31.250.128/25
# TRUSTED_PROXIES=172.31.250.10

# Port host (semua terikat ke 127.0.0.1)
WEB_PORT=8088
API_PORT=8089
DB_PORT=55432
