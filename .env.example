# Salin ke .env hanya kalau ingin mengubah default. Tanpa .env pun
# `docker compose up --build` sudah jalan dengan nilai di bawah.

APP_ENV=production
LOG_LEVEL=info

# Ganti sebelum stack dibuka ke jaringan lain.
POSTGRES_PASSWORD=mganik

# Port host (semua terikat ke 127.0.0.1)
WEB_PORT=8088
API_PORT=8089
DB_PORT=55432
